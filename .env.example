# ═════════════════════ SISTEMA DE SOLICITUDES DE RRHH ═════════════════════
# Copia este archivo a .env y completa lo marcado como OBLIGATORIO.
# Los comentarios van SIEMPRE en su propia línea (en la misma línea se leerían como valor).
# Guía completa: README.md

# ───────── INTEGRACIONES OBLIGATORIAS DEL PROYECTO ─────────
# Con true, el sistema NO arranca si falta la IA (Groq u Ollama), el inicio de sesión con Keycloak o el usuario de Power BI.
# Para una prueba local rápida pon false. Comprobación real: docker compose exec backend python -m app.check
REQUIRE_INTEGRATIONS=true

# ───────── OBLIGATORIO ─────────
# Contraseña de la base de datos de la aplicación
POSTGRES_PASSWORD=postgres123
# Puerto de tu PC por el que Power BI Desktop se conecta a la base (cámbialo solo si el 5432 ya está ocupado)
POSTGRES_HOST_PORT=5432
# Clave para firmar sesiones y cifrar la CLABE. Genera una con:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=clave-secreta-para-firmar-tokens-y-sesiones-evaluacion-2026
# Nombre de tu empresa (se imprime en las constancias y en la pantalla de acceso)
COMPANY_NAME=PluriOne S.A. de C.V.

# ───────── PRIMER ADMINISTRADOR ─────────
# Opción A (recomendada): deja esto vacío. Al abrir el sistema por primera vez verás un asistente para crearlo.
# Opción B: créalo automáticamente al arrancar (útil en despliegues automatizados)
FIRST_ADMIN_EMAIL=admin@plurione.com
FIRST_ADMIN_PASSWORD=Admin2026!
# Si lo defines, el asistente de primer uso exigirá este token (evita que un extraño cree el admin si el sistema queda expuesto)
SETUP_TOKEN=

# ───────── INICIO DE SESIÓN: KEYCLOAK (obligatorio, ya viene en Docker) ─────────
# local = solo contraseña · oidc = solo Keycloak · both = ambos (recomendado)
AUTH_MODE=both
# Contraseñas de Keycloak (OBLIGATORIAS): la del administrador de su consola y la de su base de datos
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak123
# URL con la que TU NAVEGADOR abre Keycloak. En un servidor real: https://login.tu-dominio.com
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Con Docker estos dos se calculan solos; solo importan si corres el backend sin Docker
OIDC_ISSUER=http://localhost:8080/realms/rrhh
OIDC_CLIENT_ID=rrhh-frontend
# Dominios de correo permitidos, separados por coma (vacío = cualquier usuario del realm). Ej: develop.com.mx
OIDC_ALLOWED_DOMAINS=
OIDC_PROVIDER_NAME=Keycloak

# ───────── IA: GROQ (nube) con OLLAMA (local) de respaldo ─────────
# Orden: Groq → Ollama (si no hay internet o Groq falla) → motor de reglas. Basta con configurar uno, ambos es lo ideal.
# Clave gratuita en https://console.groq.com/keys  (revisa los límites vigentes de su plan gratuito)
GROQ_API_KEY=
# Debe soportar herramientas y modo JSON. Modelos disponibles: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# Ollama: arranca con  docker compose --profile ollama up -d  y descarga el modelo con  docker compose exec ollama ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ───────── POWER BI (obligatorio) ─────────
# Con esta contraseña se crea el usuario de solo lectura "powerbi_reader" para Power BI Desktop
POWERBI_DB_PASSWORD=Alumno2026
# URL de inserción del reporte publicado (opcional)
POWERBI_REPORT_URL=

# ───────── NOTIFICACIONES EXTERNAS (opcionales) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=rrhh@tu-dominio.com
TEAMS_WEBHOOK_URL=

# ───────── REGLAS DE NEGOCIO (valores por defecto) ─────────
VACATION_MIN_NOTICE_DAYS=3
VACATION_MAX_CONSECUTIVE_DAYS=15
VACATION_HR_APPROVAL_DAYS=10
MEDICAL_CERT_REQUIRED_DAYS=2
TEAM_MAX_ABSENT_RATIO=0.5
HTTP_PORT=80
CORS_ORIGINS=http://localhost
